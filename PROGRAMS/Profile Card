<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile Card</title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background: linear-gradient(135deg, #667eea, #764ba2);
    font-family: Arial;
}

.card{
    width:300px;
    background:white;
    border-radius:15px;
    text-align:center;
    padding:20px;
    box-shadow:0 10px 25px rgba(0,0,0,0.2);
    transition:0.3s;
}

.card:hover{
    transform: scale(1.05);
}

img{
    width:100px;
    height:100px;
    border-radius:50%;
    border:3px solid #667eea;
    margin-top:10px;
}

h2{
    margin:10px 0 5px;
}

p{
    color:gray;
    font-size:14px;
}

.btn{
    margin-top:15px;
    padding:10px 15px;
    border:none;
    border-radius:20px;
    background:#667eea;
    color:white;
    cursor:pointer;
    transition:0.3s;
}

.btn:hover{
    background:#4a5bdc;
}
</style>

</head>

<body>

<div class="card">
    <img src="https://i.pravatar.cc/150?img=12" alt="profile">
    <h2>John Doe</h2>
    <p>Frontend Developer</p>
    <p>Love building clean and modern UI designs.</p>
    <button class="btn">Follow</button>
</div>

</body>
</html>
